{
  "$defs": {
    "AnalysisSummary": {
      "additionalProperties": false,
      "description": "What a field's card in My fields says about its last analysis; worked out by the web app.",
      "properties": {
        "kind": {
          "description": "keep the current rotation, or switch to one with fewer/as many/more poor seasons",
          "enum": [
            "keep",
            "fewer",
            "same",
            "more"
          ],
          "title": "Kind",
          "type": "string"
        },
        "best": {
          "description": "the best rotation's crops",
          "items": {
            "$ref": "#/$defs/Crop"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Best",
          "type": "array"
        },
        "best_poor": {
          "description": "poor seasons of the best rotation",
          "minimum": 0,
          "title": "Best Poor",
          "type": "integer"
        },
        "current_poor": {
          "description": "poor seasons of the current rotation",
          "minimum": 0,
          "title": "Current Poor",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "best",
        "best_poor",
        "current_poor"
      ],
      "title": "AnalysisSummary",
      "type": "object"
    },
    "Crop": {
      "enum": [
        "maize",
        "wheat",
        "barley",
        "soybean",
        "sunflower",
        "pea",
        "cover_mustard",
        "cover_phacelia",
        "cover_vetch",
        "fallow"
      ],
      "title": "Crop",
      "type": "string"
    },
    "FieldRequest": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/LatLon"
        },
        "current_rotation": {
          "items": {
            "$ref": "#/$defs/Crop"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Current Rotation",
          "type": "array"
        },
        "priorities": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "weights 0-1 per priority; normalised server-side",
          "propertyNames": {
            "$ref": "#/$defs/Priority"
          },
          "title": "Priorities",
          "type": "object"
        },
        "irrigated": {
          "default": false,
          "title": "Irrigated",
          "type": "boolean"
        }
      },
      "required": [
        "location",
        "current_rotation",
        "priorities"
      ],
      "title": "FieldRequest",
      "type": "object"
    },
    "LastAnalysis": {
      "additionalProperties": false,
      "description": "The saved analysis in brief, listed with the field (the full analysis is fetched apart).",
      "properties": {
        "analyzed_at": {
          "description": "ISO 8601, UTC",
          "title": "Analyzed At",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/AnalysisSummary"
        },
        "current": {
          "description": "run with the field's present inputs; false once the field or crops changed",
          "title": "Current",
          "type": "boolean"
        }
      },
      "required": [
        "analyzed_at",
        "summary",
        "current"
      ],
      "title": "LastAnalysis",
      "type": "object"
    },
    "LatLon": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "LatLon",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "yield",
        "water",
        "soil",
        "risk"
      ],
      "title": "Priority",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/FieldRequest"
    },
    "boundary": {
      "items": {
        "$ref": "#/$defs/LatLon"
      },
      "maxItems": 500,
      "minItems": 3,
      "title": "Boundary",
      "type": "array"
    },
    "parts": {
      "description": "further pieces of the same field (parcels that do not touch the boundary)",
      "items": {
        "items": {
          "$ref": "#/$defs/LatLon"
        },
        "maxItems": 500,
        "minItems": 3,
        "type": "array"
      },
      "maxItems": 40,
      "title": "Parts",
      "type": "array"
    },
    "near": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "nearest commune name",
      "title": "Near"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "created_at": {
      "description": "ISO 8601, UTC",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "description": "ISO 8601, UTC",
      "title": "Updated At",
      "type": "string"
    },
    "last_analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/LastAnalysis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "name",
    "request",
    "boundary",
    "id",
    "created_at",
    "updated_at"
  ],
  "title": "SavedField",
  "type": "object",
  "$id": "https://field-signal/contracts/saved_field/0.2.0"
}
