  "caveats": [
    {
      "ro": "Exemplu provizoriu scris de mână pentru o fermă demonstrativă lângă Aiud (două câmpuri, circa 37 ha și 8 ha); nu este un răspuns al API-ului.",
      "en": "Provisional example written by hand for a demo farm near Aiud (two fields, about 37 ha and 8 ha); it is not an answer from the API."
    },
    {
      "ro": "Scorurile provin dintr-un model de lume simulat (mock-0), nu dintr-un model antrenat: doar cifre demonstrative.",
      "en": "Scores come from a mock world model (mock-0), not a trained model: demo numbers only."
    },
    {
      "ro": "Vremea provine dintr-o grilă grosieră (NASA POWER, 0,5° x 0,625°, circa 50 km), deci câmpurile din aceeași celulă au aceeași vreme.",
      "en": "Weather comes from a coarse grid (NASA POWER, 0.5° x 0.625°, about 50 km), so fields in the same cell share the same weather."
    },
    {
      "ro": "Umiditatea din zona rădăcinilor este o valoare de model MERRA-2 pentru o celulă de circa 50 km, nu o măsurătoare în câmp.",
      "en": "Root-zone wetness is a MERRA-2 model value for a cell of about 50 km, not a field measurement."
    },
    {
      "ro": "Ferestrele meteo sunt un test de stres pe baza istoricului, nu o prognoză. Cel mai rău caz este cea mai slabă fereastră înregistrată, nu o limită inferioară.",
      "en": "The weather windows are a historical stress test, not a forecast. The worst case is the worst window on record, not a floor."
    },
    {
      "ro": "Verificările regulilor sunt provizorii, simplificate și neverificate.",
      "en": "The rule checks are provisional, simplified and unverified."
    },
    {
      "ro": "Citirea GAEC 7 este provizorie: regula la nivel de parcelă nu este modelată.",
      "en": "The GAEC 7 reading is provisional: the parcel-level rule is not modelled."
    },
    {
      "ro": "Acoperirea solului, eligibilitatea și excepțiile nu sunt verificate (neverificat).",
      "en": "Soil cover, eligibility and exemptions are not checked (unverified)."
    },
    {
      "ro": "Nu a fost impusă nicio regulă din eco-schema PD-04.",
      "en": "No eco-scheme (PD-04) rule was enforced."
    },
    {
      "ro": "Locul 1 este cea mai bună soluție găsită; este optimă pentru model doar când solverul o demonstrează.",
      "en": "Rank 1 is the best solution found; it is optimal for the model only when the solver proves it."
    },
    {
      "ro": "Istoricul culturilor a fost presupus din rotația actuală, citită de la coadă la cap.",
      "en": "Crop history was assumed from the current rotation, read backwards."
    },
    {
      "ro": "Rezultatul este o împărțire a suprafeței, nu o hartă de semănat.",
      "en": "The result is an area split, not a planting map."
    },
    {
      "ro": "Locurile 2 și 3 sunt alternative care diferă prin cel puțin două alegeri de rotație, nu următoarele cele mai bune soluții.",
      "en": "Ranks 2 and 3 are alternatives that differ in at least two rotation choices, not the next-best solutions."
    },
    {
      "ro": "Scorurile sunt indicatori agronomici și de mediu, nu profit.",
      "en": "Scores are agronomic and environmental proxies, not profit."
    }
