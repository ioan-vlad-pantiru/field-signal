# Copy to .env (gitignored) and fill in.

# NASA Earthdata login (https://urs.earthdata.nasa.gov) — used by earthaccess
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Chat model for the WhatsApp bot: OpenAI-compatible endpoint (Qwen on CCRO Labs inference)
LLM_API_KEY=
LLM_BASE_URL=https://local-inference-api.ccrolabs.com/v1
LLM_MODEL=qwen

# API
ENVIRONMENT=development

# WhatsApp bot on the Meta WhatsApp Cloud API (services/api/src/api/whatsapp/README.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any string you choose; type the same one into Meta's webhook config
WHATSAPP_VERIFY_TOKEN=
