# Copy to .env (gitignored) and fill in.

# NASA Earthdata login (https://urs.earthdata.nasa.gov) — used by earthaccess
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Chat model for the WhatsApp bot: OpenAI-compatible endpoint (Qwen on Alibaba Model Studio)
LLM_API_KEY=
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash

# API
ENVIRONMENT=development

# WhatsApp bot (services/api/src/api/whatsapp/README.md)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Exact URL set in the Twilio sandbox, e.g. https://<tunnel>/v1/whatsapp/webhook
PUBLIC_WEBHOOK_URL=
