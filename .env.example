# Copy to .env (gitignored) and fill in.

# NASA Earthdata login (https://urs.earthdata.nasa.gov) — used by earthaccess
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# LLM provider API key (provider TBD)
LLM_API_KEY=

# API
ENVIRONMENT=development

# WhatsApp bot (services/api/src/api/whatsapp/README.md)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Exact URL set in the Twilio sandbox, e.g. https://<tunnel>/v1/whatsapp/webhook
PUBLIC_WEBHOOK_URL=
# Chat answers: Azure OpenAI (endpoint + key + deployment name) or OPENAI_API_KEY
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
