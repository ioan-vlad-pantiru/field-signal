{
  "$defs": {
    "Crop": {
      "enum": [
        "maize",
        "wheat",
        "barley",
        "soybean",
        "sunflower",
        "pea",
        "cover_mustard",
        "cover_phacelia",
        "cover_vetch",
        "fallow"
      ],
      "title": "Crop",
      "type": "string"
    },
    "LatLon": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "LatLon",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "yield",
        "water",
        "soil",
        "risk"
      ],
      "title": "Priority",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "location": {
      "$ref": "#/$defs/LatLon"
    },
    "current_rotation": {
      "items": {
        "$ref": "#/$defs/Crop"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Current Rotation",
      "type": "array"
    },
    "priorities": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "weights 0-1 per priority; normalised server-side",
      "propertyNames": {
        "$ref": "#/$defs/Priority"
      },
      "title": "Priorities",
      "type": "object"
    },
    "irrigated": {
      "default": false,
      "title": "Irrigated",
      "type": "boolean"
    }
  },
  "required": [
    "location",
    "current_rotation",
    "priorities"
  ],
  "title": "FieldRequest",
  "type": "object",
  "$id": "https://field-signal/contracts/field_request/0.1.0"
}
