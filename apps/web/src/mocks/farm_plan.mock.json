  "caveats": [
    {
      "ro": "Scorurile vin dintr-un model MOCK al lumii (mock-0), nu dintr-un model antrenat: sunt valori provizorii, nu predicții.",
      "en": "Scores come from a MOCK world model (mock-0), not a trained model: they are placeholders, not predictions."
    },
    {
      "ro": "Câmpurile sunt tăiate pe o grilă grosieră de 0,0025° (celule de circa 280 m x 190 m); fiecare bucată primește valorile celulei sale.",
      "en": "Fields are cut by a coarse 0.0025° grid (cells of about 280 m x 190 m); each piece takes the values of its cell."
    },
    {
      "ro": "Fiecare câmp primește vremea celulei sale NASA POWER (circa 50 km), comună tuturor câmpurilor din aceeași celulă; umiditatea din zona rădăcinilor este o valoare de model MERRA-2, nu o măsurătoare în câmp.",
      "en": "Each field takes the weather of its NASA POWER cell (about 50 km), shared by every field in that cell; root-zone wetness is a MERRA-2 model value, not a field measurement."
    },
    {
      "ro": "Acoperirea este grila NASA POWER peste România: un câmp aflat chiar dincolo de graniță, într-o celulă acoperită, este planificat cu aceleași date.",
      "en": "Coverage is the NASA POWER grid over Romania: a field just across the border that falls in a covered cell is planned with the same data."
    },
    {
      "ro": "Scenariile sunt un test de stres pe istoric (1982-2025), nu o prognoză; cel mai rău caz este cea mai rea fereastră înregistrată, nu o limită inferioară.",
      "en": "Scenarios are a historical stress test (1982-2025), not a forecast; the worst case is the worst window on record, not a floor."
    },
    {
      "ro": "Verificările regulilor sunt provizorii, simplificate și neverificate: limitele vin din surse secundare, necitite încă în documentele oficiale 2026, iar pragurile de 10 ha / 30 ha se aplică suprafeței totale desenate. Numerele regulilor sunt neverificate.",
      "en": "Rule checks are provisional, simplified and unverified: the limits come from secondary sources not yet read in the official 2026 documents, and the 10 ha / 30 ha thresholds are applied to the total drawn area. The rule numbers are unverified."
    },
    {
      "ro": "Citirea GAEC 7 este provizorie: regula la nivel de parcelă (ce este o parcelă, culturi secundare, perioada de referință, excepții) nu este modelată.",
      "en": "The GAEC 7 reading is provisional: the parcel-level rule (what counts as a parcel, secondary crops, the reference period, exemptions) is not modelled."
    },
    {
      "ro": "Acoperirea solului (GAEC 6 și PD-04, 15 iunie-15 octombrie) nu este verificată (neverificat).",
      "en": "Soil cover (GAEC 6 and PD-04, 15 June-15 October) is not checked (unverified)."
    },
    {
      "ro": "Eligibilitatea și excepțiile nu sunt verificate (neverificat).",
      "en": "Eligibility and exemptions are not checked (unverified)."
    },
    {
      "ro": "Nu a fost impusă nicio regulă a eco-schemei PD-04; rândurile PD-04 sunt doar informative.",
      "en": "No eco-scheme (PD-04) rule was enforced; the PD-04 rows are for information only."
    },
    {
      "ro": "Locul 1 este cea mai bună soluție găsită; este afișată ca optimă doar când solverul o dovedește.",
      "en": "Rank 1 is the best solution found; it is shown as optimal only when the solver proves it."
    },
    {
      "ro": "Locurile 2 și 3 sunt alternative care schimbă rotația a cel puțin două câmpuri (a singurului câmp, la o fermă cu un câmp), nu următoarele cele mai bune soluții.",
      "en": "Ranks 2 and 3 are alternatives that change the rotation of at least two fields (of the only field on a one-field farm), not the next-best solutions."
    },
    {
      "ro": "Fiecare câmp are o singură rotație, o cultură pe an pe toată suprafața sa; regulile fermei se calculează pe ansamblul câmpurilor.",
      "en": "Each field carries one rotation, one crop per year on its whole area; the farm rules are computed across fields."
    },
    {
      "ro": "Intervalele de revenire sunt verificate în plan și față de istoricul culturilor, nu peste sfârșitul planului: planul nu se presupune repetat.",
      "en": "Return intervals are checked inside the plan and against the crop history, not across the end of the plan: the plan is not assumed to repeat."
    },
    {
      "ro": "Scorurile sunt indicatori agronomici și de mediu, nu profit.",
      "en": "Scores are agronomic and environmental proxies, not profit."
    },
    {
      "ro": "Istoricul culturilor este presupus din rotația curentă citită invers (f1, f2).",
      "en": "Crop history is assumed from the current rotation read backwards (f1, f2)."
    }
