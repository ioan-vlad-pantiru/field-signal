{
  "$defs": {
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Crop": {
      "enum": [
        "maize",
        "wheat",
        "barley",
        "soybean",
        "sunflower",
        "pea",
        "cover_mustard",
        "cover_phacelia",
        "cover_vetch",
        "fallow"
      ],
      "title": "Crop",
      "type": "string"
    },
    "DataSource": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "description": "e.g. 'NASA POWER'",
          "title": "Dataset",
          "type": "string"
        },
        "product": {
          "description": "e.g. 'T2M_MAX, daily'",
          "title": "Product",
          "type": "string"
        },
        "resolution": {
          "description": "e.g. '0.5° x 0.625°' or '250 m'",
          "title": "Resolution",
          "type": "string"
        },
        "period": {
          "description": "e.g. '2001-2025'",
          "title": "Period",
          "type": "string"
        },
        "is_nasa": {
          "title": "Is Nasa",
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "dataset",
        "product",
        "resolution",
        "period",
        "is_nasa"
      ],
      "title": "DataSource",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/Localized"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "source": {
          "description": "dataset name, must match a DataSource.dataset",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "text",
        "source"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Explanation": {
      "additionalProperties": false,
      "properties": {
        "why": {
          "$ref": "#/$defs/Localized"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "benefits": {
          "items": {
            "$ref": "#/$defs/Localized"
          },
          "title": "Benefits",
          "type": "array"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/Localized"
          },
          "title": "Gaps",
          "type": "array"
        },
        "risks": {
          "items": {
            "$ref": "#/$defs/LocalRisk"
          },
          "title": "Risks",
          "type": "array"
        },
        "generated_by": {
          "enum": [
            "template",
            "llm"
          ],
          "title": "Generated By",
          "type": "string"
        }
      },
      "required": [
        "why",
        "evidence",
        "benefits",
        "gaps",
        "risks",
        "generated_by"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "FieldCell": {
      "additionalProperties": false,
      "description": "One 1 ha hexagon of the field plan (`apps/web/src/lib/field-plan.ts`).",
      "properties": {
        "id": {
          "description": "axial 'q,r' of a pointy-top 1 ha hexagon; '0,0' is centred on location.point",
          "title": "Id",
          "type": "string"
        },
        "cropland_fraction": {
          "description": "share of the hexagon mapped as cropland; source in `sources`",
          "maximum": 1,
          "minimum": 0,
          "title": "Cropland Fraction",
          "type": "number"
        }
      },
      "required": [
        "id",
        "cropland_fraction"
      ],
      "title": "FieldCell",
      "type": "object"
    },
    "Indicator": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "e.g. 'jul_hot_days', 'ndvi_peak', 'smap_rootzone_jul_aug'",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Localized"
        },
        "description": {
          "$ref": "#/$defs/Localized"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "higher_is_worse": {
          "title": "Higher Is Worse",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/DataSource"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/YearValue"
          },
          "title": "Series",
          "type": "array"
        },
        "baseline_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Mean"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "unit",
        "higher_is_worse",
        "source",
        "series"
      ],
      "title": "Indicator",
      "type": "object"
    },
    "LatLon": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "LatLon",
      "type": "object"
    },
    "LocalRisk": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/Localized"
        },
        "needs_local_review": {
          "default": true,
          "title": "Needs Local Review",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "LocalRisk",
      "type": "object"
    },
    "Localized": {
      "additionalProperties": false,
      "properties": {
        "ro": {
          "title": "Ro",
          "type": "string"
        },
        "en": {
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "ro",
        "en"
      ],
      "title": "Localized",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "point": {
          "$ref": "#/$defs/LatLon"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "commune": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commune"
        },
        "county": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "County"
        },
        "siruta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Romanian SIRUTA code of the commune",
          "title": "Siruta"
        }
      },
      "required": [
        "point",
        "label"
      ],
      "title": "Location",
      "type": "object"
    },
    "Range": {
      "additionalProperties": false,
      "description": "An estimate with its uncertainty. `low <= mid <= high`.",
      "properties": {
        "low": {
          "title": "Low",
          "type": "number"
        },
        "mid": {
          "title": "Mid",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "low",
        "mid",
        "high"
      ],
      "title": "Range",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "description": "One machine-readable driver behind a status or score.",
      "properties": {
        "code": {
          "description": "stable id, e.g. 'heat_at_flowering'",
          "title": "Code",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Localized"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "code",
        "label"
      ],
      "title": "Reason",
      "type": "object"
    },
    "ScoreBreakdown": {
      "additionalProperties": false,
      "description": "0-100, higher is better for the farmer.",
      "properties": {
        "total": {
          "maximum": 100,
          "minimum": 0,
          "title": "Total",
          "type": "number"
        },
        "yield_stability": {
          "maximum": 100,
          "minimum": 0,
          "title": "Yield Stability",
          "type": "number"
        },
        "water": {
          "maximum": 100,
          "minimum": 0,
          "title": "Water",
          "type": "number"
        },
        "soil_health": {
          "maximum": 100,
          "minimum": 0,
          "title": "Soil Health",
          "type": "number"
        },
        "low_risk": {
          "maximum": 100,
          "minimum": 0,
          "title": "Low Risk",
          "type": "number"
        }
      },
      "required": [
        "total",
        "yield_stability",
        "water",
        "soil_health",
        "low_risk"
      ],
      "title": "ScoreBreakdown",
      "type": "object"
    },
    "SeasonOutcome": {
      "additionalProperties": false,
      "properties": {
        "year": {
          "title": "Year",
          "type": "integer"
        },
        "crop": {
          "$ref": "#/$defs/Crop"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "evidence_level": {
          "$ref": "#/$defs/Confidence",
          "description": "lower before SMAP (2015) or with cloud-gapped vegetation data"
        }
      },
      "required": [
        "year",
        "crop",
        "status",
        "reasons",
        "evidence_level"
      ],
      "title": "SeasonOutcome",
      "type": "object"
    },
    "SoilProfile": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "default": "0-30cm",
          "title": "Depth",
          "type": "string"
        },
        "soc_g_per_kg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Soc G Per Kg"
        },
        "ph_h2o": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ph H2O"
        },
        "clay_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clay Pct"
        },
        "sand_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sand Pct"
        },
        "silt_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Silt Pct"
        },
        "texture_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/Localized"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/DataSource"
        }
      },
      "required": [
        "source"
      ],
      "title": "SoilProfile",
      "type": "object"
    },
    "Status": {
      "enum": [
        "good",
        "watch",
        "bad",
        "no_data"
      ],
      "title": "Status",
      "type": "string"
    },
    "Strategy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Localized"
        },
        "is_current": {
          "title": "Is Current",
          "type": "boolean"
        },
        "sequence": {
          "items": {
            "$ref": "#/$defs/Crop"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Sequence",
          "type": "array"
        },
        "score": {
          "$ref": "#/$defs/ScoreBreakdown"
        },
        "score_range": {
          "$ref": "#/$defs/Range"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "replay": {
          "items": {
            "$ref": "#/$defs/SeasonOutcome"
          },
          "title": "Replay",
          "type": "array"
        },
        "explanation": {
          "$ref": "#/$defs/Explanation"
        }
      },
      "required": [
        "id",
        "name",
        "is_current",
        "sequence",
        "score",
        "score_range",
        "confidence",
        "replay",
        "explanation"
      ],
      "title": "Strategy",
      "type": "object"
    },
    "YearValue": {
      "additionalProperties": false,
      "properties": {
        "year": {
          "title": "Year",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "year",
        "value"
      ],
      "title": "YearValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "mock": {
      "default": false,
      "title": "Mock",
      "type": "boolean"
    },
    "location": {
      "$ref": "#/$defs/Location"
    },
    "period_start": {
      "title": "Period Start",
      "type": "integer"
    },
    "period_end": {
      "title": "Period End",
      "type": "integer"
    },
    "indicators": {
      "items": {
        "$ref": "#/$defs/Indicator"
      },
      "minItems": 3,
      "title": "Indicators",
      "type": "array"
    },
    "soil": {
      "$ref": "#/$defs/SoilProfile"
    },
    "strategies": {
      "items": {
        "$ref": "#/$defs/Strategy"
      },
      "minItems": 3,
      "title": "Strategies",
      "type": "array"
    },
    "caveats": {
      "items": {
        "$ref": "#/$defs/Localized"
      },
      "title": "Caveats",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/DataSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "field_cells": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/FieldCell"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "per-hexagon farmland mask; null = not computed",
      "title": "Field Cells"
    }
  },
  "required": [
    "location",
    "period_start",
    "period_end",
    "indicators",
    "soil",
    "strategies",
    "caveats",
    "sources"
  ],
  "title": "FieldAnalysis",
  "type": "object",
  "$id": "https://field-signal/contracts/field_analysis/0.1.0"
}
